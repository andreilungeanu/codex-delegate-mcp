{
  "name": "codex-delegate-mcp",
  "version": "3.2.0",
  "mcpName": "io.github.andreilungeanu/codex-delegate-mcp",
  "type": "module",
  "description": "Ask OpenAI Codex what it thinks, or hand it the work. Second opinions, model comparisons, plans, edits and native code review, inside Claude Code, Cursor or any MCP client.",
  "license": "MIT",
  "author": "Andrei Lungeanu <andrei@lungeanu.ro>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreilungeanu/codex-delegate-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/andreilungeanu/codex-delegate-mcp/issues"
  },
  "homepage": "https://github.com/andreilungeanu/codex-delegate-mcp#readme",
  "keywords": [
    "mcp",
    "codex",
    "openai",
    "claude-code",
    "cursor",
    "github-copilot",
    "vscode",
    "delegate"
  ],
  "main": "src/server.js",
  "bin": {
    "codex-delegate-mcp": "src/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "README.md",
    "CONFIGURATION.md",
    "PRIVACY.md",
    "SECURITY.md",
    "TERMS.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:pack": "node scripts/npm-package-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "bench": "vitest bench --run",
    "start": "node src/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "^6.1.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
